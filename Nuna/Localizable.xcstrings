    "Three stories a week are always free. Subscribe to unlock the whole library." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثلاث قصص كل أسبوع مجانية دائمًا. اشترك لفتح المكتبة كاملة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drei Geschichten pro Woche sind immer kostenlos. Abonniere, um die ganze Bibliothek freizuschalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Three stories a week are always free. Subscribe to unlock the whole library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tres cuentos a la semana son siempre gratis. Suscríbete para desbloquear toda la biblioteca."

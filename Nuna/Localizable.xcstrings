        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحتاج نونا إلى الإنترنت في المرة الأولى فقط لفتح الكتاب. بعد نزوله على هذا الجهاز، يعمل بدون إنترنت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",

    "This Apple Account doesn't have an active Nuna subscription. If someone else in your family subscribed, make sure Family Sharing is turned on in Settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد لدى حساب Apple هذا اشتراك نشط في نونا. إذا كان شخص آخر في عائلتك مشتركًا، فتأكد من تفعيل المشاركة العائلية في الإعدادات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Apple-Account hat kein aktives Nuna-Abo. Wenn jemand anderes in deiner Familie abonniert hat, prüfe, ob die Familienfreigabe in den Einstellungen aktiviert ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Apple Account doesn't have an active Nuna subscription. If someone else in your family subscribed, make sure Family Sharing is turned on in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta Cuenta Apple no tiene una suscripción activa de Nuna. Si alguien más de tu familia se suscribió, asegúrate de que Compartir en Familia esté activado en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce compte Apple n'a pas d'abonnement Nuna actif. Si quelqu'un d'autre dans ta famille est abonné, vérifie que le Partage familial est activé dans Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo Account Apple non ha un abbonamento Nuna attivo. Se qualcun altro nella tua famiglia si è abbonato, controlla che In famiglia sia attivo in Impostazioni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta Conta Apple não tem uma assinatura Nuna ativa. Se outra pessoa da família assinou, confira se o Compartilhamento Familiar está ligado nos Ajustes."
          }
        }
      }
    },

# Mídia no Git LFS: arte (HEIC/PNG/JPEG), motion (MP4) e narração (MP3).
# Sem isto, cada reexportação do pipeline somaria centenas de MB ao histórico.
*.heic filter=lfs diff=lfs merge=lfs -text
*.png  filter=lfs diff=lfs merge=lfs -text
*.jpg  filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.mp4  filter=lfs diff=lfs merge=lfs -text
*.mp3  filter=lfs diff=lfs merge=lfs -text

# As capturas do README ficam FORA do LFS: são pequenas (~100 KB) e a página
# do projeto as mostra a cada visita — no LFS, cada visita gastaria da cota
# de banda da conta.
docs/screenshots/*.jpg !filter !diff !merge -text
